ARG LEARNER_RUNTIME_IMAGE=rl-training/learner:test-001
FROM ${LEARNER_RUNTIME_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/rl-learner-dev-requirements.txt
RUN pip install --no-cache-dir \
        -r /tmp/rl-learner-dev-requirements.txt && \
    rm /tmp/rl-learner-dev-requirements.txt

WORKDIR /workspace/rl-learner
ENTRYPOINT []
CMD ["sleep", "infinity"]
