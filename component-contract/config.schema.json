{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rl-training.local/schemas/learner-config.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "identity",
    "training",
    "model",
    "sample_pool",
    "model_distributor",
    "aiserver_status",
    "metric_events",
    "dashboard",
    "log"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name", "package_version", "source_digest",
        "artifact_digest", "platform", "generator_identity",
        "training_contract_path"
      ],
      "properties": {
        "package_name": {"type": "string", "minLength": 1},
        "package_version": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "platform": {"type": "string", "minLength": 1},
        "generator_identity": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "training_contract_path": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_lineage_id"],
      "properties": {
        "model_lineage_id": {"type": "string", "minLength": 1}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device", "seed", "learning_rate", "gamma", "gae_lambda", "tmax",
        "clip_epsilon", "value_clip_epsilon", "entropy_coef", "value_coef",
        "max_grad_norm", "n_epochs", "train_batch_size", "mini_batch_size",
        "normalize_advantage"
      ],
      "properties": {
        "device": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "gamma": {"type": "number", "minimum": 0, "maximum": 1},
        "gae_lambda": {"type": "number", "minimum": 0, "maximum": 1},
        "tmax": {"type": "integer", "minimum": 1},
        "clip_epsilon": {"type": "number", "exclusiveMinimum": 0},
        "value_clip_epsilon": {"type": "number", "exclusiveMinimum": 0},
        "entropy_coef": {"type": "number", "minimum": 0},
        "value_coef": {"type": "number", "minimum": 0},
        "max_grad_norm": {"type": "number", "exclusiveMinimum": 0},
        "n_epochs": {"type": "integer", "minimum": 1},
        "train_batch_size": {"type": "integer", "minimum": 1},
        "mini_batch_size": {"type": "integer", "minimum": 1},
        "normalize_advantage": {"type": "boolean"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_model_path", "local_train_dir", "archive_interval_updates",
        "publication_retention_steps", "bootstrap_seed"
      ],
      "properties": {
        "initial_model_path": {"type": ["string", "null"]},
        "local_train_dir": {"type": "string", "minLength": 1},
        "archive_interval_updates": {"type": "integer", "minimum": 1},
        "publication_retention_steps": {"type": "integer", "minimum": 1},
        "bootstrap_seed": {"type": "integer", "minimum": 0}
      }
    },
    "sample_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host", "port", "get_timeout_ms", "lease_timeout_ms",
        "finalize_request_path", "finalize_complete_path",
        "shutdown_drain_timeout_ms"
      ],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "get_timeout_ms": {"type": "integer", "minimum": 1},
        "lease_timeout_ms": {"type": "integer", "minimum": 1},
        "finalize_request_path": {"type": "string", "pattern": "^/"},
        "finalize_complete_path": {"type": "string", "pattern": "^/"},
        "shutdown_drain_timeout_ms": {"type": "integer", "minimum": 1}
      }
    },
    "model_distributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "aiserver_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "initial_model_ack_timeout_sec"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "initial_model_ack_timeout_sec": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        }
      }
    },
    "metric_events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_enabled", "server_port", "aiserver_relay_enabled"],
      "properties": {
        "server_enabled": {"type": "boolean"},
        "server_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "aiserver_relay_enabled": {"type": "boolean"}
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "server_port", "backend"],
      "properties": {
        "enabled": {"type": "boolean"},
        "server_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "backend": {"type": "string", "minLength": 1}
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["console_level", "file_level", "log_dir"],
      "properties": {
        "console_level": {"type": "string", "minLength": 1},
        "file_level": {"type": "string", "minLength": 1},
        "log_dir": {"type": "string", "minLength": 1}
      }
    }
  }
}
