{
  "layout_key": "rl-monitor-panels",
  "panels": [
    {
      "id": "reward",
      "title": "Reward",
      "category": "reward",
      "defaults": [
        "task.maze.return"
      ],
      "order": 20
    },
    {
      "id": "episode",
      "title": "Episode",
      "category": "episode",
      "defaults": [
        "task.maze.episode_length"
      ],
      "order": 30
    },
    {
      "id": "success",
      "title": "Success Rate",
      "category": "success",
      "defaults": [
        "task.maze.any_success",
        "task.maze.all_success"
      ],
      "order": 40
    }
  ],
  "fields": [
    {
      "match": "task.maze.success",
      "display_unit": "%",
      "display_scale": 100
    },
    {
      "match": "task.maze.any_success",
      "display_unit": "%",
      "display_scale": 100
    },
    {
      "match": "task.maze.all_success",
      "display_unit": "%",
      "display_scale": 100
    },
    {
      "match": "task.maze.blocked_move_rate",
      "display_unit": "%",
      "display_scale": 100
    }
  ]
}
